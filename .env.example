# ===== Discord =====
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# ===== SellAuth =====
# Found in SellAuth dashboard -> API settings. Used as a Bearer token.
SELLAUTH_API_KEY=
# Your numeric SellAuth shop ID.
SELLAUTH_SHOP_ID=

# ===== Branding / Behavior =====
PREFIX=!
SHOP_NAME=Plutostokz
ORDER_PREFIX=PLUTO

# ===== Roles =====
# A single role ID that marks a member as staff. Administrators always count as staff.
STAFF_ROLE_ID=

# ===== Channels / Categories =====
# Leave blank on first run - !setup will create these and you should then
# copy the printed IDs back into this file (and your Render env vars) so
# restarts reuse the same channels instead of relying on in-memory state.
TICKET_CATEGORY_ID=
SHOP_CATEGORY_ID=
SHOP_CHANNEL_ID=
ORDERS_CHANNEL_ID=
LOGS_CHANNEL_ID=
SUPPORT_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=

# ===== Render / HTTP health check =====
PORT=10000
